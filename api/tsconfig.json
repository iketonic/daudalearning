{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "target": "es2023",
    "module": "preserve",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@": ["./"]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
  },
  "include": [
    "src/",
  //   "generated",
  //   "package.json",
    "*.d.ts",
  ],
  "exclude": [
    "node_modules/",
    "prisma/",
    "**/*.specs.ts",
    "generated",
  ]
}