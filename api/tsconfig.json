{
  "compilerOptions": {
    "types": ["node"],
    "target": "es2023",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@": ["./"]
    }
    // "noEmit": true,
  },
  "include": [
    "src/",
  //   "generated",
  //   "package.json",
    "*.d.ts",
  ],
  "exclude": [
    "node_modules/",
    "**/*.specs.ts",
    "generated",
  ]
}