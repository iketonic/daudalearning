{
  "name": "openhack-hackathon-server",
  "version": "1.0.0",
  "main": "src/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node -r dotenv/config dist/index.js",
    "build": "rm -rf dist && babel src --extensions .ts --out-dir dist --copy-files",
    "dev": "node --watch --watch-preserve-output --import tsx/cjs -r dotenv/config src/index.ts | npx pino-pretty",
    "studio": "prisma studio",
    "generate": "prisma generate",
    "seed": "prisma db seed",
    "push": "prisma db push --force-reset"
  },
  "author": "OpenHack Team",
  "license": "MIT",
  "description": "Hackathon Server for OpenHack",
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "tsx": "^4.23.12"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "http": "^0.0.1-security",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}
