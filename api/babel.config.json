{
    "plugins": [
        [
            "babel-plugin-module-resolver", {
               "root": "./src",
               "alias": {
                    "@": "./src"
               }
            }
        ]
    ],
    "presets": [
        ["@babel/preset-env", { "modules": "commonjs", "targets": { "node": "current" } } ],
        ["@babel/preset-typescript", { "ignoreExtensions": false }]
    ],
    "compact": true,
    "comments": false,
    "sourceType": "unambiguous"
}